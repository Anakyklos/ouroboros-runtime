# Ouroboros Environment Configuration
# Copy this file to .env and fill in your API keys

# Required: Groq API Key (for Concierge intent classification)
GROQ_API_KEY=gsk_your_key_here

# Required: Google API Key (for Gemini CLI)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Jules API Key (async GitHub PR tasks)
# Get from: https://jules.google.com/settings
# Quota: 100 requests/day
JULES_API_KEY=your_jules_api_key_here

# Optional: Default GitHub repo for Jules (format: sources/github/owner/repo)
JULES_DEFAULT_SOURCE=

# Optional: Override default paths
# OUROBOROS_ROOT=.ouroboros
# OUROBOROS_WORKSPACE=.ouroboros/workspace
