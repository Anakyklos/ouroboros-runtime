{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "outDir": "./dist",
        "rootDir": ".",
        "types": [
            "node"
        ]
    },
    "include": [
        "cli/src/**/*.ts",
        "scripts/**/*.ts",
        "*.ts"
    ],
    "exclude": [
        "node_modules",
        ".ouroboros",
        "dist"
    ]
}